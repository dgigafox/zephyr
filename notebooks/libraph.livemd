# Libgraph

```elixir
Mix.install([
  {:libgraph, "~> 0.16.0"}
])
```

## Section

### Sample schema

```
entity user {}

entity organization {

    relation admin @user
    relation member @user

    action create_repository = admin or member
    action delete = admin

}
```

```elixir
alias Graph.Edge

g =
  Graph.new()
  |> Graph.add_edges([
    {{:definition, :organization}, {:permission, :delete}},
    {{:definition, :organization}, {:permission, :create_repository}},
    {{:definition, :organization}, {:relation, :admin}},
    {{:definition, :organization}, {:relation, :member}},
    {{:permission, :create_repository}, {:operator, :+}},
    {{:operator, :+}, {:relation, :member}},
    {{:operator, :+}, {:relation, :admin}},
    {{:permission, :delete}, {:relation, :admin}}
  ])
```

```elixir
g = Graph.transpose(g)
list = Graph.topsort(g)
```

delete = organization#admin  
create_repository = organization#member + delete

```elixir
Enum.slice(list, 0..0)
```

```elixir
defmodule Traverse do
  def build(list) do
    {:definition, entity} = List.last(list)
    {permissions, _} = Keyword.pop_values(list, :permission)

    Enum.reduce(permissions, {0, []}, fn permission, {start_index, collection} ->
      end_index = Enum.find_index(list, &(&1 == {:permission, permission}))
      children = Enum.slice(list, start_index..(end_index - 1))
      equation = build_equation(entity, children)
      {end_index, [{permission, equation} | collection]}
    end)
  end

  defp build_equation(entity, vertices) do
    do_build_equation(vertices, entity)
  end

  defp do_build_equation([left, right, {:operator, operator} | rest], entity) do
    left = parse(left, entity)
    right = parse(right, entity)
    do_build_equation([{operator, [left, right]} | rest], entity)
  end

  defp do_build_equation([v], entity), do: parse(v, entity)

  defp parse({:relation, relation}, entity) do
    "#{entity}##{relation}"
  end

  defp parse({:permission, permission}, entity) do
    "#{entity}.#{permission}"
  end

  defp parse({_operator, [_left, _right]} = equation, _), do: equation
end
```

```elixir
Traverse.build(list)
```

```elixir
g =
  Graph.new()
  |> Graph.add_edges([
    Edge.new({:definition, :basic_documents}, {:permission, :write}),
    Edge.new({:definition, :basic_documents}, {:permission, :read}),
    Edge.new({:definition, :basic_documents}, {:relation, :writer}),
    Edge.new({:definition, :basic_documents}, {:relation, :reader}),
    Edge.new({:permission, :write}, {:relation, :writer}),
    Edge.new({:permission, :read}, {:operator, :+}),
    Edge.new({:operator, :+}, {:relation, :reader}),
    Edge.new({:operator, :+}, {:permission, :write})
  ])
```

```elixir
g = Graph.transpose(g)
sorted = Graph.topsort(g)
```

write = basic_documents#writer  
read = basic_documents#reader + write

