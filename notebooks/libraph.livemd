```
entity user {}

entity group {
    relation member @user @group#member
}

entity document {
    relation writer @user @group#member
    
    relation reader @user @group#member
    
    permission write = writer

    permission read = reader or write
}
```

```elixir
equation =
  Enum.reduce(sorted, "", fn
    {:operator, :+}, acc -> acc <> " + "
    {:relation, relation}, acc -> acc <> "##{relation}"
    {_, var}, acc -> acc <> Atom.to_string(var)
  end)
```

write = basic_documents#writer@basic_users or basic_documents#writer@basic_groups#member@basic_users

read = (basic_documents#reader@basic_users or basic_documents#reader@basic_groups#member@basic_users) + write

```elixir
defmodule MiniCompiler do
  @keywords ~w(entity relation action)a
  @operators ~w(= or)a

  defmodule AST do
    defstruct [:entities]
  end

  defmodule Entity do
    defstruct [:name, :relations, :actions]
  end

  defmodule Relation do
    defstruct [:name, :target]
  end

  defmodule Action do
    defstruct [:name, :rule]
  end

  # Step 1: Tokenizer
  def tokenize(input) do
    input
    |> String.replace(~r/[{}]/, " \\0 ")
    |> String.split()
    |> IO.inspect()
    |> Enum.map(&classify_token/1)
  end

  defp classify_token("entity"), do: {:keyword, :entity}
  defp classify_token("relation"), do: {:keyword, :relation}
  defp classify_token("action"), do: {:keyword, :action}
  defp classify_token("or"), do: {:operator, :or}
  defp classify_token("="), do: {:operator, :equal}
  defp classify_token("{"), do: {:brace, :open}
  defp classify_token("}"), do: {:brace, :close}

  defp classify_token(text) do
    if String.starts_with?(text, "@") do
      {:relation_target, String.trim_leading(text, "@")}
    else
      {:identifier, text}
    end
  end

  # Step 2: Parser
  def parse(tokens) do
    parse_entities(tokens, %AST{entities: []})
  end

  defp parse_entities(
         [{:keyword, :entity}, {:identifier, entity_name}, {:brace, :open} | rest],
         %AST{} = ast
       ) do
    {entity, tokens} = parse_entity(rest, %Entity{name: entity_name, relations: [], actions: []})
    parse_entities(tokens, %{ast | entities: [entity | ast.entities]})
  end

  defp parse_entities([], ast), do: ast

  defp parse_entity(
         [{:keyword, :relation}, {:identifier, relation_name}, {:relation_target, target} | rest],
         %Entity{} = entity
       ) do
    relation = %Relation{name: relation_name, target: target}
    parse_entity(rest, %{entity | relations: [relation | entity.relations]})
  end

  defp parse_entity(
         [{:keyword, :action}, {:identifier, action_name}, {:operator, :equal} | rest],
         %Entity{} = entity
       ) do
    {rule, tokens} = parse_rule(rest)
    action = %Action{name: action_name, rule: rule}
    parse_entity(tokens, %{entity | actions: [action | entity.actions]})
  end

  defp parse_entity([{:brace, :close} | rest], entity), do: {entity, rest}

  defp parse_rule([{:identifier, condition}, {:operator, :or} | rest]) do
    {next_condition, tokens} = parse_rule(rest)
    {[:or, condition, next_condition], tokens}
  end

  defp parse_rule([{:identifier, condition} | rest]), do: {condition, rest}

  # Step 3: Building the AST
  def build_ast(input) do
    input
    |> tokenize()
    |> parse()
  end
end
```

```elixir
# Test input
input = """
entity user {}

entity organization {

    relation admin @user
    relation member @user
    relation public @user

    action create_repository = admin or member or public
    action delete = admin

}
"""

# Create AST
ast = MiniCompiler.build_ast(input)
IO.inspect(ast, label: "AST")
```
